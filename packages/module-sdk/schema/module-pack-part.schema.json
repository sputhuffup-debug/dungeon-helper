{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://campaign-forge.dev/schema/module-pack-part.schema.json",
  "title": "Campaign Forge module data pack part",
  "description": "More collections for a split pack; the pack's `parts` lists it by `name`.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "campaign-forge-pack-part"
    },
    "formatVersion": {
      "const": 1
    },
    "pack": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.json$"
    },
    "entityTypes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entityType"
      }
    },
    "relationshipTypes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/relationshipType"
      }
    },
    "referenceLists": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/referenceList"
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/preset"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/table"
      }
    },
    "procedures": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/procedure"
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/template"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ruleCard"
      }
    },
    "trackers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/tracker"
      }
    },
    "playGuides": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/playGuide"
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "pack",
    "name"
  ],
  "additionalProperties": false,
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "page": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      ],
      "description": "A page, or an inclusive [first, last] range."
    },
    "cite": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "A section citation, e.g. \"SRD 5.1, Conditions\"."
    },
    "modes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/id"
      }
    },
    "tone": {
      "type": "string",
      "enum": [
        "critical",
        "success",
        "partial",
        "failure",
        "fumble",
        "neutral"
      ]
    },
    "playMode": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "page": {
          "$ref": "#/definitions/page"
        },
        "cite": {
          "$ref": "#/definitions/cite"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "properties": {
        "spdx": {
          "type": "string",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2000
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "attribution"
      ],
      "additionalProperties": false
    },
    "sourceBook": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer"
        },
        "pageNote": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2000
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,47}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ruleset": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "licenseNotice": {
          "type": "string",
          "minLength": 1
        },
        "requiredCore": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+"
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/playMode"
          },
          "minItems": 1
        },
        "defaultMode": {
          "$ref": "#/definitions/id"
        },
        "dataStatus": {
          "enum": [
            "unverified",
            "partially-verified",
            "verified"
          ]
        },
        "sourceBook": {
          "$ref": "#/definitions/sourceBook"
        },
        "license": {
          "$ref": "#/definitions/license"
        },
        "citationStyle": {
          "enum": [
            "page",
            "section"
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "ruleset",
        "licenseNotice",
        "requiredCore",
        "modes",
        "defaultMode",
        "dataStatus",
        "license"
      ],
      "additionalProperties": false
    },
    "d20": {
      "type": "object",
      "properties": {
        "engine": {
          "const": "d20"
        },
        "abilityModifier": {
          "type": "boolean"
        },
        "proficiency": {
          "description": "JSONLogic (https://jsonlogic.com), evaluated by the SDK. Literals evaluate to themselves."
        },
        "bonus": {
          "description": "JSONLogic (https://jsonlogic.com), evaluated by the SDK. Literals evaluate to themselves."
        },
        "critOn": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "fumbleOn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 19
        },
        "critSucceeds": {
          "type": "boolean"
        },
        "fumbleFails": {
          "type": "boolean"
        },
        "freeDice": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 100
          },
          "maxItems": 10
        },
        "labels": {
          "type": "object",
          "properties": {
            "success": {
              "type": "string",
              "minLength": 1
            },
            "failure": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "engine"
      ],
      "additionalProperties": false
    },
    "poolDie": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "faces": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        },
        "success": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "bane": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "count": {
          "description": "JSONLogic (https://jsonlogic.com), evaluated by the SDK. Literals evaluate to themselves."
        },
        "color": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-z]{3,20})$"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "pool": {
      "type": "object",
      "properties": {
        "engine": {
          "const": "pool"
        },
        "dice": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/poolDie"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "minDice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "push": {
          "anyOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "properties": {
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "lockBanes": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "labels": {
          "type": "object",
          "properties": {
            "success": {
              "type": "string",
              "minLength": 1
            },
            "failure": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "engine"
      ],
      "additionalProperties": false
    },
    "band": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "$ref": "#/definitions/tone"
        }
      },
      "required": [
        "min",
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "2d6": {
      "type": "object",
      "properties": {
        "engine": {
          "const": "2d6"
        },
        "stat": {
          "description": "JSONLogic (https://jsonlogic.com), evaluated by the SDK. Literals evaluate to themselves."
        },
        "bands": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/band"
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "engine"
      ],
      "additionalProperties": false
    },
    "degree": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "tone": {
          "$ref": "#/definitions/tone"
        }
      },
      "required": [
        "id",
        "label",
        "fraction"
      ],
      "additionalProperties": false
    },
    "d100": {
      "type": "object",
      "properties": {
        "engine": {
          "const": "d100"
        },
        "target": {
          "description": "JSONLogic (https://jsonlogic.com), evaluated by the SDK. Literals evaluate to themselves."
        },
        "degrees": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/degree"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "criticalAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "fumbleAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 101
        },
        "fumbleLowTarget": {
          "type": "object",
          "properties": {
            "below": {
              "type": "integer",
              "minimum": 1,
              "maximum": 101
            },
            "at": {
              "type": "integer",
              "minimum": 1,
              "maximum": 101
            }
          },
          "required": [
            "below",
            "at"
          ],
          "additionalProperties": false
        },
        "tensDice": {
          "type": "boolean"
        },
        "push": {
          "anyOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "properties": {
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "labels": {
          "type": "object",
          "properties": {
            "failure": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "engine"
      ],
      "additionalProperties": false
    },
    "dice": {
      "type": "object",
      "required": [
        "engine"
      ],
      "properties": {
        "engine": {
          "enum": [
            "d20",
            "pool",
            "2d6",
            "d100"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "engine": {
                "const": "d20"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/d20"
          }
        },
        {
          "if": {
            "properties": {
              "engine": {
                "const": "pool"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/pool"
          }
        },
        {
          "if": {
            "properties": {
              "engine": {
                "const": "2d6"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/2d6"
          }
        },
        {
          "if": {
            "properties": {
              "engine": {
                "const": "d100"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/d100"
          }
        }
      ]
    },
    "tableModifier": {
      "type": "object",
      "properties": {
        "when": {
          "description": "JSONLogic (https://jsonlogic.com), evaluated by the SDK. Literals evaluate to themselves."
        },
        "add": {
          "description": "JSONLogic (https://jsonlogic.com), evaluated by the SDK. Literals evaluate to themselves."
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "add"
      ],
      "additionalProperties": false
    },
    "nestedRoll": {
      "type": "object",
      "properties": {
        "table": {
          "$ref": "#/definitions/id"
        },
        "as": {
          "type": "string",
          "minLength": 1
        },
        "times": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "table",
        "as"
      ],
      "additionalProperties": false
    },
    "tableRow": {
      "type": "object",
      "properties": {
        "range": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "label": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "gmDecides": {
          "type": "boolean"
        },
        "roll": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/nestedRoll"
          }
        },
        "page": {
          "$ref": "#/definitions/page"
        },
        "cite": {
          "$ref": "#/definitions/cite"
        },
        "unverified": {
          "type": "boolean"
        }
      },
      "required": [
        "range",
        "result"
      ],
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "$ref": "#/definitions/page"
        },
        "cite": {
          "$ref": "#/definitions/cite"
        },
        "original": {
          "type": "boolean"
        },
        "dice": {
          "type": "string",
          "minLength": 1
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/tableModifier"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/tableRow"
          },
          "minItems": 1
        },
        "mode": {
          "$ref": "#/definitions/modes"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "unverified": {
          "type": "boolean"
        },
        "family": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "dice",
        "rows"
      ],
      "additionalProperties": false
    },
    "sheetField": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "widget": {
          "type": "string",
          "enum": [
            "text",
            "textarea",
            "richtext",
            "number",
            "checkbox",
            "select",
            "multiselect",
            "tags",
            "attribute",
            "skill",
            "skills",
            "talents",
            "conditions",
            "gear",
            "dicepool",
            "supply",
            "stress",
            "computed",
            "ref",
            "reflist",
            "statblock",
            "table",
            "list",
            "entries",
            "object",
            "image",
            "zonemap"
          ]
        },
        "rule": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/modes"
        },
        "readonly": {
          "type": "boolean"
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "options": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "$ref": "#/definitions/id"
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            }
          ]
        },
        "entityTypes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/id"
          }
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "sheetSection": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "$ref": "#/definitions/modes"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sheetField"
          }
        },
        "collapsed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "fields"
      ],
      "additionalProperties": false
    },
    "sheet": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sheetSection"
          }
        },
        "summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sections"
      ],
      "additionalProperties": false
    },
    "subtype": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sheet": {
          "$ref": "#/definitions/sheet"
        },
        "schema": {
          "type": "object",
          "description": "A JSON Schema (draft-07, safe subset: no remote $ref, no pattern/patternProperties, no $data)."
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "entityType": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "character",
            "creature",
            "location",
            "faction",
            "item",
            "vehicle",
            "clue",
            "job",
            "encounter"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "plural": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "maxLength": 40
        },
        "schema": {
          "type": "object",
          "description": "A JSON Schema (draft-07, safe subset: no remote $ref, no pattern/patternProperties, no $data)."
        },
        "sheet": {
          "$ref": "#/definitions/sheet"
        },
        "computed": {
          "type": "object",
          "additionalProperties": {
            "description": "JSONLogic (https://jsonlogic.com), evaluated by the SDK. Literals evaluate to themselves."
          }
        },
        "defaultVisibility": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "gm",
              "players",
              "some_players",
              "revealed"
            ]
          }
        },
        "mode": {
          "$ref": "#/definitions/modes"
        },
        "playerEditable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subtypes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/subtype"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "plural",
        "schema",
        "sheet"
      ],
      "additionalProperties": false
    },
    "relationshipType": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "forward": {
          "type": "string",
          "minLength": 1
        },
        "reverse": {
          "type": "string",
          "minLength": 1
        },
        "fromKinds": {
          "type": "array",
          "items": {
