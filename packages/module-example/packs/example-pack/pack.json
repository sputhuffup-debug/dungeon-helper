    "conditions": [
      {
        "id": "dazed",
        "name": "Dazed",
        "summary": "Head ringing: −1 per level to checks and attack rolls. Drops by 1 at the end of each of its turns.",
        "cite": "LRD, Conditions: Dazed",
        "valued": true,
        "max": 3,
        "field": "dazed",
        "effects": [{ "on": ["check", "attack"], "modifier": { "*": [-1, { "var": "value" }] }, "bonusType": "status" }],
        "endOfTurnDecrement": 1
      },
      { "id": "shaken", "name": "Shaken", "summary": "−1 to checks.", "cite": "LRD, Conditions: Shaken", "effects": [{ "on": ["check"], "modifier": -1, "bonusType": "status" }] },
      { "id": "sick", "name": "Sick", "summary": "Disadvantage on attack rolls and checks.", "cite": "LRD, Conditions: Sick", "effects": [{ "on": ["attack", "check"], "roll": "disadvantage" }] },
      {
        "id": "down",
        "name": "Down",
        "summary": "On the ground: disadvantage on its attacks; close attackers have advantage against it, distant ones disadvantage.",
        "cite": "LRD, Conditions: Down",
        "effects": [
          { "on": ["attack"], "roll": "disadvantage" },
          { "on": ["attack"], "against": true, "range": "close", "roll": "advantage" },
          { "on": ["attack"], "against": true, "range": "far", "roll": "disadvantage" }
        ],
        "manual": ["standing up costs half its movement"]
      },
      {
        "id": "helpless",
        "name": "Helpless",
        "summary": "Can't act or react. Attacks against it have advantage, and a close hit is a critical hit.",
        "cite": "LRD, Conditions: Helpless",
        "cannot": ["act", "react"],
        "effects": [
          { "on": ["attack"], "against": true, "roll": "advantage" },
          { "on": ["attack"], "against": true, "range": "close", "critOnHit": true }
        ]
      },
      {
        "id": "stunned",
        "name": "Stunned",
        "summary": "Helpless, and fails Might and Grace saves.",
        "cite": "LRD, Conditions: Stunned",
        "implies": ["helpless"],
        "effects": [{ "on": ["save"], "saves": ["might-save", "grace-save"], "autoFail": true }]
      },
      { "id": "knocked-out", "name": "Knocked out", "summary": "Unconscious: helpless and down until healed.", "cite": "LRD, Conditions: Knocked out", "implies": ["helpless", "down"] },
      { "id": "burning", "name": "Burning", "summary": "Takes the noted fire damage at the end of each of its turns until it puts the fire out.", "cite": "LRD, Conditions: Burning", "manual": ["roll the fire damage at the end of its turn", "putting the fire out"] }
    ],
    "zeroHp": [
      { "when": { "==": [{ "var": "kind" }, "character"] }, "conditions": [{ "id": "knocked-out" }], "recover": { "remove": ["knocked-out"] }, "text": "An adventurer at 0 HP is knocked out until healed.", "cite": "LRD, Combat: Down and out" },
      { "defeated": true, "text": "A monster at 0 HP is defeated.", "cite": "LRD, Combat: Down and out" }
    ],
    "closeLabel": "within reach",
    "persistentCondition": "burning",
    "playerHealth": true
