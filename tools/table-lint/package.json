{
  "name": "@campaign-forge/table-lint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint-tables": "node --experimental-strip-types --no-warnings --import ./register.mjs src/cli.ts"
  },
  "dependencies": {
    "@campaign-forge/module-sdk": "workspace:*",
    "@campaign-forge/module-alien": "workspace:*",
    "@campaign-forge/module-example": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.5"
  },
  "bin": {
    "table-lint": "./src/cli.ts"
  }
}
